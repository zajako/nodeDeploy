<%- include('partials/head') %>

<div class="d-flex flex-column min-vh-100 bg-dark">
  <%- include('partials/navbar') %>
  <%- include('partials/flash') %>

  <main class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
          <div class="text-center mb-4">
            <i class="bi bi-cloud-upload-fill display-3 text-primary"></i>
            <h1 class="h2 fw-bold mt-2">NodeDeploy</h1>
            <p class="text-muted">Node.js Application Deployment Portal</p>
          </div>

          <div class="card bg-secondary-dark border-secondary shadow-lg">
            <div class="card-body p-4">
              <h2 class="card-title h5 mb-4 text-center">Sign in to continue</h2>

              <div class="mb-4 text-center text-muted small">
                <p class="mb-1"><i class="bi bi-shield-lock me-1"></i>Access restricted to authorized administrators.</p>
                <p class="mb-0">Sign in with your GitHub account to manage deployments.</p>
              </div>

              <a href="/auth/github" class="btn btn-light w-100 btn-lg d-flex align-items-center justify-content-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                </svg>
                Sign in with GitHub
              </a>

              <hr class="my-4 border-secondary" />

              <div class="text-center">
                <div class="d-flex justify-content-center gap-4 text-muted small">
                  <div>
                    <i class="bi bi-rocket-takeoff text-primary d-block fs-5 mb-1"></i>
                    Deploy apps
                  </div>
                  <div>
                    <i class="bi bi-arrow-repeat text-success d-block fs-5 mb-1"></i>
                    Auto-update
                  </div>
                  <div>
                    <i class="bi bi-activity text-info d-block fs-5 mb-1"></i>
                    Monitor
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('partials/footer') %>
</div>

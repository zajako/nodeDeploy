<%- include('../partials/head') %>

<div class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-grow-1 py-4">
    <div class="container-fluid px-4">

      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-0 fw-bold">Projects</h1>
          <p class="text-muted mb-0 small">Manage your deployed applications</p>
        </div>
        <a href="/admin/projects/new" class="btn btn-primary">
          <i class="bi bi-plus-lg me-1"></i>New Project
        </a>
      </div>

      <div class="card border-secondary">
        <div class="card-body p-0">
          <% if (projects && projects.length > 0) { %>
          <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
              <thead class="table-secondary">
                <tr>
                  <th class="ps-4">Name</th>
                  <th>URL</th>
                  <th>Branch</th>
                  <th>Port</th>
                  <th>Status</th>
                  <th>Last Deployed</th>
                  <th class="text-end pe-4">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% projects.forEach(function(p) { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold"><%= p.name %></div>
                    <small class="text-muted text-truncate d-block" style="max-width:250px"><%= p.repo_url %></small>
                  </td>
                  <td>
                    <% if (p.status === 'active') { %>
                    <a href="https://<%= p.name %>.<%= baseDomain %>" target="_blank" class="text-primary small">
                      <%= p.name %>.<%= baseDomain %> <i class="bi bi-box-arrow-up-right ms-1"></i>
                    </a>
                    <% } else { %>
                    <span class="text-muted small"><%= p.name %>.<%= baseDomain %></span>
                    <% } %>
                  </td>
                  <td><span class="badge bg-dark border border-secondary"><%= p.branch %></span></td>
                  <td><span class="text-muted small"><%= p.port %></span></td>
                  <td>
                    <% if (p.status === 'active') { %>
                    <span class="badge bg-success"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Active</span>
                    <% } else if (p.status === 'stopped') { %>
                    <span class="badge bg-secondary"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Stopped</span>
                    <% } else if (p.status === 'error') { %>
                    <span class="badge bg-danger"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Error</span>
                    <% } else { %>
                    <span class="badge bg-warning text-dark"><i class="bi bi-arrow-repeat me-1"></i>Deploying</span>
                    <% } %>
                  </td>
                  <td class="text-muted small">
                    <% if (p.last_deployed) { %>
                    <%= new Date(p.last_deployed).toLocaleString() %>
                    <% } else { %>
                    Never
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <div class="btn-group btn-group-sm">
                      <a href="/admin/projects/<%= p.id %>" class="btn btn-outline-secondary" title="View">
                        <i class="bi bi-eye"></i>
                      </a>
                      <form action="/admin/projects/<%= p.id %>/deploy" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-primary" title="Redeploy">
                          <i class="bi bi-arrow-repeat"></i>
                        </button>
                      </form>
                      <% if (p.status === 'active') { %>
                      <form action="/admin/projects/<%= p.id %>/stop" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-warning" title="Stop">
                          <i class="bi bi-stop-circle"></i>
                        </button>
                      </form>
                      <% } else { %>
                      <form action="/admin/projects/<%= p.id %>/start" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-outline-success" title="Start">
                          <i class="bi bi-play-circle"></i>
                        </button>
                      </form>
                      <% } %>
                    </div>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
          <% } else { %>
          <div class="text-center py-5">
            <i class="bi bi-folder2-open display-3 text-muted d-block mb-3"></i>
            <h4 class="text-muted">No projects yet</h4>
            <p class="text-muted mb-4">Deploy your first Node.js application from GitHub.</p>
            <a href="/admin/projects/new" class="btn btn-primary btn-lg">
              <i class="bi bi-plus-lg me-2"></i>Deploy Your First App
            </a>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

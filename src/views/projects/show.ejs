<%- include('../partials/head') %>

<div class="d-flex flex-column min-vh-100">
  <%- include('../partials/navbar') %>
  <%- include('../partials/flash') %>

  <main class="flex-grow-1 py-4">
    <div class="container-fluid px-4">

      <!-- Header -->
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
          <a href="/admin/projects" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-1"></i>Back
          </a>
          <div class="d-flex align-items-center gap-3">
            <h1 class="h3 fw-bold mb-0"><%= project.name %></h1>
            <% if (project.status === 'active') { %>
            <span class="badge bg-success fs-6"><i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Active</span>
            <% } else if (project.status === 'stopped') { %>
            <span class="badge bg-secondary fs-6">Stopped</span>
            <% } else if (project.status === 'error') { %>
            <span class="badge bg-danger fs-6">Error</span>
            <% } else { %>
            <span class="badge bg-warning text-dark fs-6"><i class="bi bi-arrow-repeat me-1"></i>Deploying</span>
            <% } %>
          </div>
          <% if (project.status === 'active') { %>
          <div class="d-flex flex-wrap gap-3 align-items-center">
            <a href="https://<%= project.name %>.<%= baseDomain %>" target="_blank" class="text-muted small">
              <%= project.name %>.<%= baseDomain %> <i class="bi bi-box-arrow-up-right ms-1"></i>
            </a>
            <% if (project.custom_domain) { %>
            <a href="https://<%= project.custom_domain %>" target="_blank" class="text-info small">
              <i class="bi bi-globe me-1"></i><%= project.custom_domain %> <i class="bi bi-box-arrow-up-right ms-1"></i>
            </a>
            <% } %>
          </div>
          <% } %>
        </div>

        <!-- Action buttons -->
        <div class="d-flex flex-wrap gap-2">
          <form action="/admin/projects/<%= project.id %>/deploy" method="POST">
            <button type="submit" class="btn btn-primary btn-sm">
              <i class="bi bi-rocket-takeoff me-1"></i>Deploy
            </button>
          </form>
          <form action="/admin/projects/<%= project.id %>/restart" method="POST">
            <button type="submit" class="btn btn-outline-info btn-sm">
              <i class="bi bi-arrow-repeat me-1"></i>Restart
            </button>
          </form>
          <% if (project.status === 'active' || project.status === 'error') { %>
          <form action="/admin/projects/<%= project.id %>/stop" method="POST">
            <button type="submit" class="btn btn-outline-warning btn-sm">
              <i class="bi bi-stop-circle me-1"></i>Stop
            </button>
          </form>
          <% } else { %>
          <form action="/admin/projects/<%= project.id %>/start" method="POST">
            <button type="submit" class="btn btn-outline-success btn-sm">
              <i class="bi bi-play-circle me-1"></i>Start
            </button>
          </form>
          <% } %>
          <a href="/admin/projects/<%= project.id %>/edit" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-pencil me-1"></i>Edit
          </a>
          <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="bi bi-trash me-1"></i>Delete
          </button>
        </div>
      </div>

      <!-- Tabs -->
      <ul class="nav nav-tabs mb-4 border-secondary" id="projectTabs">
        <li class="nav-item">
          <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overviewTab">
            <i class="bi bi-info-circle me-1"></i>Overview
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#envTab">
            <i class="bi bi-key me-1"></i>Environment
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#logsTab" id="logsTabBtn">
            <i class="bi bi-journal-text me-1"></i>Logs
          </button>
        </li>
        <li class="nav-item">
          <button class="nav-link" data-bs-toggle="tab" data-bs-target="#appLogsTab" id="appLogsTabBtn">
            <i class="bi bi-terminal me-1"></i>App Logs
          </button>
        </li>
      </ul>

      <div class="tab-content">

        <!-- Overview Tab -->
        <div class="tab-pane fade show active" id="overviewTab">
          <div class="row g-4">
            <div class="col-md-6">
              <div class="card border-secondary h-100">
                <div class="card-header"><h6 class="mb-0">Repository</h6></div>
                <div class="card-body">
                  <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">URL</dt>
                    <dd class="col-sm-8">
                      <a href="<%= project.repo_url %>" target="_blank" class="text-break small">
                        <%= project.repo_url %> <i class="bi bi-box-arrow-up-right ms-1"></i>
                      </a>
                    </dd>
                    <dt class="col-sm-4 text-muted">Branch</dt>
                    <dd class="col-sm-8"><span class="badge bg-dark border border-secondary"><%= project.branch %></span></dd>
                    <% if (project.repo_owner) { %>
                    <dt class="col-sm-4 text-muted">Owner</dt>
                    <dd class="col-sm-8 small"><%= project.repo_owner %></dd>
                    <% } %>
                  </dl>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="card border-secondary h-100">
                <div class="card-header"><h6 class="mb-0">Deployment</h6></div>
                <div class="card-body">
                  <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Port</dt>
                    <dd class="col-sm-8"><code><%= project.port %></code></dd>
                    <dt class="col-sm-4 text-muted">Path</dt>
                    <dd class="col-sm-8"><code class="small text-break"><%= project.deploy_path %></code></dd>
                    <dt class="col-sm-4 text-muted">Start</dt>
                    <dd class="col-sm-8"><code class="small"><%= project.start_command %></code></dd>
                    <% if (project.build_command) { %>
                    <dt class="col-sm-4 text-muted">Build</dt>
                    <dd class="col-sm-8"><code class="small"><%= project.build_command %></code></dd>
                    <% } %>
                    <dt class="col-sm-4 text-muted">Deployed</dt>
                    <dd class="col-sm-8 small">
                      <% if (project.last_deployed) { %>
                      <time data-ts="<%= new Date(project.last_deployed).toISOString() %>"></time>
                      <% } else { %>
                      <span class="text-muted">Never</span>
                      <% } %>
                    </dd>
                  </dl>
                </div>
              </div>
            </div>
            <div class="col-12">
              <div class="card border-secondary">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h6 class="mb-0">GitHub Webhook</h6>
                  <% if (!project.webhook_id) { %>
                  <form action="/admin/projects/<%= project.id %>/register-webhook" method="POST">
                    <button type="submit" class="btn btn-sm btn-outline-primary">
                      <i class="bi bi-link-45deg me-1"></i>Register Webhook
                    </button>
                  </form>
                  <% } %>
                </div>
                <div class="card-body">
                  <% if (project.webhook_id) { %>
                  <dl class="row mb-0">
                    <dt class="col-sm-3 text-muted">Status</dt>
                    <dd class="col-sm-9"><span class="badge bg-success">Active</span></dd>
                    <dt class="col-sm-3 text-muted">Webhook ID</dt>
                    <dd class="col-sm-9 small"><%= project.webhook_id %></dd>
                    <dt class="col-sm-3 text-muted">Endpoint</dt>
                    <dd class="col-sm-9"><code class="small">/webhook/<%= project.name %></code></dd>
                    <dt class="col-sm-3 text-muted">Trigger</dt>
                    <dd class="col-sm-9 small">Push to <code><%= project.branch %></code> → auto-deploy</dd>
                  </dl>
                  <% } else { %>
                  <p class="text-muted small mb-0">
                    <i class="bi bi-exclamation-circle me-1 text-warning"></i>
                    No webhook registered. Click <strong>Register Webhook</strong> to enable auto-deploy on push.
                  </p>
                  <% } %>
                </div>
              </div>
            </div>

            <!-- Custom Domain -->
            <div class="col-12">
              <div class="card border-secondary">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h6 class="mb-0"><i class="bi bi-globe me-1"></i>Custom Domain</h6>
                  <% if (project.custom_domain) { %>
                  <form action="/admin/projects/<%= project.id %>/refresh-ssl" method="POST" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-success" title="Re-check for SSL cert and reload nginx">
                      <i class="bi bi-shield-check me-1"></i>Refresh SSL
                    </button>
                  </form>
                  <% } %>
                </div>
                <div class="card-body">
                  <% if (project.custom_domain) { %>
                  <div class="mb-3">
                    <div class="d-flex flex-wrap gap-3 align-items-center">
                      <a href="http://<%= project.custom_domain %>" target="_blank" class="fw-semibold text-decoration-none">
                        <i class="bi bi-globe2 me-1 text-muted"></i><%= project.custom_domain %>
                        <i class="bi bi-box-arrow-up-right ms-1 small text-muted"></i>
                      </a>
                      <span class="text-muted small">and www.<%= project.custom_domain %></span>
                    </div>
                    <p class="text-muted small mt-2 mb-0">
                      <i class="bi bi-shield-lock me-1"></i>
                      Click <strong>Refresh SSL</strong> to obtain an HTTPS certificate automatically.
                      Ensure <code>CERTBOT_EMAIL</code> is set in <code>.env</code> and the domain's DNS points to this server.
                    </p>
                  </div>
                  <% } else { %>
                  <p class="text-muted small mb-3">
                    Map a domain you own (e.g. <code>myapp.com</code>) to this project.
                    Point both the bare domain and <code>www</code> A records to this server's IP first.
                  </p>
                  <% } %>
                  <form action="/admin/projects/<%= project.id %>/custom-domain" method="POST" class="d-flex gap-2 flex-wrap align-items-center">
                    <input type="text"
                           name="custom_domain"
                           class="form-control form-control-sm"
                           style="max-width:280px"
                           placeholder="myapp.com"
                           value="<%= project.custom_domain || '' %>" />
                    <button type="submit" class="btn btn-sm btn-primary">
                      <i class="bi bi-check-lg me-1"></i><%= project.custom_domain ? 'Update' : 'Set Domain' %>
                    </button>
                    <% if (project.custom_domain) { %>
                    <button type="submit" name="custom_domain" value="" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-x-lg me-1"></i>Remove
                    </button>
                    <% } %>
                  </form>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Environment Tab -->
        <div class="tab-pane fade" id="envTab">
          <div class="row g-4">

            <!-- Database -->
            <div class="col-12">
              <div class="card border-secondary">
                <div class="card-header d-flex justify-content-between align-items-center">
                  <h6 class="mb-0"><i class="bi bi-database me-1"></i>MySQL Database</h6>
                  <% if (dbInfo) { %>
                  <form action="/admin/projects/<%= project.id %>/database/remove" method="POST" class="m-0">
                    <button type="submit" class="btn btn-sm btn-outline-danger"
                      onclick="return confirm('Remove database credentials? The .env will be updated and the project restarted.')">
                      <i class="bi bi-trash me-1"></i>Remove
                    </button>
                  </form>
                  <% } %>
                </div>
                <div class="card-body">
                  <form action="/admin/projects/<%= project.id %>/database" method="POST">
                    <div class="row g-3">
                      <div class="col-md-4">
                        <label class="form-label small text-muted">Database Name</label>
                        <input type="text" name="db_name" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="<%= dbInfo ? dbInfo.db_name : '' %>" placeholder="myapp_db" required />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label small text-muted">Username</label>
                        <input type="text" name="db_user" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="<%= dbInfo ? dbInfo.db_user : '' %>" placeholder="myapp_user" required />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label small text-muted">
                          Password
                          <% if (dbInfo) { %><span class="text-muted fw-normal">(blank = keep existing)</span><% } %>
                        </label>
                        <input type="password" name="db_password" class="form-control form-control-sm bg-dark text-light border-secondary"
                               placeholder="<%= dbInfo ? '••••••••' : 'required' %>"
                               <%= dbInfo ? '' : 'required' %> />
                      </div>
                      <div class="col-md-4">
                        <label class="form-label small text-muted">Host</label>
                        <input type="text" name="db_host" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="<%= dbInfo ? dbInfo.db_host : 'localhost' %>" placeholder="localhost" />
                      </div>
                      <div class="col-md-2">
                        <label class="form-label small text-muted">Port</label>
                        <input type="number" name="db_port" class="form-control form-control-sm bg-dark text-light border-secondary"
                               value="<%= dbInfo ? dbInfo.db_port : 3306 %>" placeholder="3306" />
                      </div>
                      <div class="col-12">
                        <button type="submit" class="btn btn-sm btn-primary">
                          <i class="bi bi-<%= dbInfo ? 'check-lg' : 'plus-lg' %> me-1"></i><%= dbInfo ? 'Update Database' : 'Add Database' %>
                        </button>
                        <span class="text-muted small ms-2">Credentials are written to the app's <code>.env</code> and the project is restarted automatically.</span>
                      </div>
                    </div>
                  </form>
                </div>
              </div>
            </div>

            <!-- Custom Env Vars -->
            <div class="col-12">
              <div class="card border-secondary">
                <div class="card-header"><h6 class="mb-0"><i class="bi bi-key me-1"></i>Custom Environment Variables</h6></div>
                <div class="card-body p-2">

                  <!-- Column headers -->
                  <div class="d-flex gap-2 px-1 mb-1 small text-muted">
                    <div style="flex:0 0 220px">Key</div>
                    <div style="flex:1">Value</div>
                    <div style="width:130px"></div>
                  </div>

                  <!-- Existing vars -->
                  <% if (envVars && envVars.length > 0) { %>
                  <% envVars.forEach(function(ev) { %>
                  <div class="d-flex gap-2 align-items-center mb-2">
                    <form method="POST" action="/admin/projects/<%= project.id %>/env/<%= ev.id %>" class="d-flex gap-2 align-items-center" style="flex:1">
                      <input type="text" name="key_name" value="<%= ev.key_name %>" class="form-control form-control-sm font-monospace" style="flex:0 0 220px" required pattern="[A-Za-z_][A-Za-z0-9_]*">
                      <input type="text" name="value" value="<%= ev.value %>" class="form-control form-control-sm font-monospace" style="flex:1">
                      <button type="submit" class="btn btn-sm btn-primary" style="width:60px">Save</button>
                    </form>
                    <form method="POST" action="/admin/projects/<%= project.id %>/env/<%= ev.id %>/delete" onsubmit="return confirm('Delete variable <%= ev.key_name %>?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger" style="width:64px">Delete</button>
                    </form>
                  </div>
                  <% }); %>
                  <% } else { %>
                  <div class="text-center text-muted py-3 small">No custom environment variables yet.</div>
                  <% } %>

                  <!-- Add new var -->
                  <hr class="border-secondary my-2">
                  <form method="POST" action="/admin/projects/<%= project.id %>/env">
                    <div class="d-flex gap-2 align-items-center">
                      <input type="text" name="key_name" placeholder="KEY_NAME" class="form-control form-control-sm font-monospace" style="flex:0 0 220px" required pattern="[A-Za-z_][A-Za-z0-9_]*">
                      <input type="text" name="value" placeholder="value" class="form-control form-control-sm font-monospace" style="flex:1">
                      <button type="submit" class="btn btn-sm btn-success" style="width:60px">Add</button>
                      <div style="width:64px"></div>
                    </div>
                    <div class="text-muted small mt-1 ps-1">Changes regenerate the project's <code>.env</code> and restart the process automatically.</div>
                  </form>

                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Logs Tab -->
        <div class="tab-pane fade" id="logsTab">
          <div class="card border-secondary">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
              <h6 class="mb-0"><i class="bi bi-journal-text me-1"></i>Deploy Logs</h6>
              <div class="d-flex align-items-center gap-2">
                <span class="text-muted small" id="logsStatus">–</span>
                <button id="btnRefreshNow" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Refresh now">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button id="btnToggleAuto" class="btn btn-sm btn-success py-0 px-2" title="Auto-refresh on">
                  <i class="bi bi-pause-fill me-1"></i>Auto
                </button>
              </div>
            </div>
            <div class="card-body p-0">
              <div id="logsContainer">
                <% if (logs && logs.length > 0) { %>
                <table class="table table-dark table-sm mb-0">
                  <thead>
                    <tr>
                      <th class="ps-3">Time</th>
                      <th>Type</th>
                      <th>Message</th>
                    </tr>
                  </thead>
                  <tbody id="logsBody">
                    <% logs.forEach(function(log) { %>
                    <tr>
                      <td class="ps-3 text-muted small text-nowrap"><time data-ts="<%= new Date(log.created_at).toISOString() %>"></time></td>
                      <td>
                        <% if (log.log_type === 'deploy') { %>
                        <span class="badge bg-primary-subtle text-primary-emphasis">deploy</span>
                        <% } else if (log.log_type === 'error') { %>
                        <span class="badge bg-danger-subtle text-danger-emphasis">error</span>
                        <% } else if (log.log_type === 'webhook') { %>
                        <span class="badge bg-info-subtle text-info-emphasis">webhook</span>
                        <% } else { %>
                        <span class="badge bg-secondary-subtle text-secondary-emphasis">info</span>
                        <% } %>
                      </td>
                      <td class="small"><%= log.message %></td>
                    </tr>
                    <% }); %>
                  </tbody>
                </table>
                <% } else { %>
                <div class="text-center text-muted py-5">
                  <i class="bi bi-journal display-6 d-block mb-2"></i>No logs yet.
                </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>

        <!-- App Logs Tab -->
        <div class="tab-pane fade" id="appLogsTab">
          <div class="card border-secondary">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
              <h6 class="mb-0"><i class="bi bi-terminal me-1"></i>PM2 App Logs</h6>
              <div class="d-flex align-items-center gap-2">
                <div class="btn-group btn-group-sm" role="group">
                  <button id="btnAppLogsOut" type="button" class="btn btn-primary py-0 px-2 active">stdout</button>
                  <button id="btnAppLogsErr" type="button" class="btn btn-outline-secondary py-0 px-2">stderr</button>
                </div>
                <select id="appLogsLines" class="form-select form-select-sm py-0" style="width:90px">
                  <option value="100">100 lines</option>
                  <option value="200" selected>200 lines</option>
                  <option value="500">500 lines</option>
                </select>
                <span class="text-muted small" id="appLogsStatus">–</span>
                <button id="btnAppLogsRefresh" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Refresh now">
                  <i class="bi bi-arrow-clockwise"></i>
                </button>
                <button id="btnAppLogsAuto" class="btn btn-sm btn-success py-0 px-2" title="Auto-refresh on">
                  <i class="bi bi-pause-fill me-1"></i>Auto
                </button>
              </div>
            </div>
            <div class="card-body p-0">
              <pre id="appLogsContainer" class="mb-0 p-3 small" style="background:#0d1117;color:#c9d1d9;max-height:600px;overflow-y:auto;white-space:pre-wrap;word-break:break-all;">Loading…</pre>
            </div>
          </div>
        </div>

      </div><!-- /tab-content -->

    </div>
  </main>

  <%- include('../partials/footer') %>
</div>

<!-- Delete modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark border-secondary">
      <div class="modal-header border-secondary">
        <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Project</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p>Are you sure you want to delete <strong><%= project.name %></strong>? This action cannot be undone.</p>
        <form action="/admin/projects/<%= project.id %>?_method=DELETE" method="POST" id="deleteForm">
          <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="delete_files" name="delete_files" value="on" />
            <label class="form-check-label" for="delete_files">
              Also delete files from disk (<code><%= project.deploy_path %></code>)
            </label>
          </div>
          <div class="d-flex gap-2 justify-content-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">
              <i class="bi bi-trash me-1"></i>Delete Project
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
// Convert all server-rendered timestamps to the viewer's local timezone
document.querySelectorAll('time[data-ts]').forEach(function (el) {
  el.textContent = new Date(el.dataset.ts).toLocaleString();
});

// Activate tab from ?tab= query param (e.g. after env var save redirect)
(function () {
  const params = new URLSearchParams(window.location.search);
  const tab = params.get('tab');
  if (tab) {
    const btn = document.querySelector('[data-bs-target="#' + tab + 'Tab"]');
    if (btn) { bootstrap.Tab.getOrCreateInstance(btn).show(); }
  }
}());

(function () {
  const PROJECT_ID   = '<%= project.id %>';
  const INTERVAL_MS  = 5000;   // auto-refresh every 5 s
  const STATUS_EL    = document.getElementById('logsStatus');
  const TOGGLE_BTN   = document.getElementById('btnToggleAuto');
  const REFRESH_BTN  = document.getElementById('btnRefreshNow');

  let autoEnabled    = true;
  let logsTabActive  = false;
  let timer          = null;   // setInterval handle
  let countdown      = INTERVAL_MS / 1000;
  let countdownTimer = null;

  // ── Badge helper ─────────────────────────────────────────────
  function badge(type) {
    const map = {
      deploy:  'bg-primary-subtle text-primary-emphasis',
      error:   'bg-danger-subtle text-danger-emphasis',
      webhook: 'bg-info-subtle text-info-emphasis',
      info:    'bg-secondary-subtle text-secondary-emphasis'
    };
    const cls = map[type] || map.info;
    return `<span class="badge ${cls}">${type || 'info'}</span>`;
  }

  function esc(str) {
    return str ? String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;') : '';
  }

  // ── Render logs into the DOM ──────────────────────────────────
  function renderLogs(logs) {
    const container = document.getElementById('logsContainer');
    if (!logs.length) {
      container.innerHTML = '<div class="text-center text-muted py-5"><i class="bi bi-journal display-6 d-block mb-2"></i>No logs yet.</div>';
      return;
    }
    let tbody = document.getElementById('logsBody');
    if (!tbody) {
      container.innerHTML = `<table class="table table-dark table-sm mb-0">
        <thead><tr><th class="ps-3">Time</th><th>Type</th><th>Message</th></tr></thead>
        <tbody id="logsBody"></tbody></table>`;
      tbody = document.getElementById('logsBody');
    }
    tbody.innerHTML = logs.map(l => `
      <tr>
        <td class="ps-3 text-muted small text-nowrap">${new Date(l.created_at).toLocaleString()}</td>
        <td>${badge(l.log_type)}</td>
        <td class="small">${esc(l.message)}</td>
      </tr>`).join('');
  }

  // ── Fetch from API ────────────────────────────────────────────
  async function fetchLogs() {
    try {
      const res  = await fetch(`/admin/projects/${PROJECT_ID}/logs`);
      const data = await res.json();
      renderLogs(data.logs || []);
      STATUS_EL.textContent = 'Updated ' + new Date().toLocaleTimeString();
    } catch (e) {
      STATUS_EL.textContent = 'Fetch failed – ' + new Date().toLocaleTimeString();
    }
  }

  // ── Countdown ticker shown in status bar ─────────────────────
  function startCountdown() {
    clearInterval(countdownTimer);
    countdown = INTERVAL_MS / 1000;
    countdownTimer = setInterval(() => {
      countdown--;
      if (countdown > 0) STATUS_EL.textContent = `Refreshing in ${countdown}s`;
    }, 1000);
  }

  // ── Auto-refresh loop ─────────────────────────────────────────
  function startAuto() {
    if (timer) return;
    fetchLogs();
    startCountdown();
    timer = setInterval(() => {
      fetchLogs();
      startCountdown();
    }, INTERVAL_MS);
  }

  function stopAuto() {
    clearInterval(timer);
    clearInterval(countdownTimer);
    timer = null;
  }

  // ── Toggle button ─────────────────────────────────────────────
  TOGGLE_BTN.addEventListener('click', () => {
    autoEnabled = !autoEnabled;
    if (autoEnabled) {
      TOGGLE_BTN.className = 'btn btn-sm btn-success py-0 px-2';
      TOGGLE_BTN.innerHTML = '<i class="bi bi-pause-fill me-1"></i>Auto';
      if (logsTabActive) startAuto();
    } else {
      TOGGLE_BTN.className = 'btn btn-sm btn-outline-secondary py-0 px-2';
      TOGGLE_BTN.innerHTML = '<i class="bi bi-play-fill me-1"></i>Manual';
      STATUS_EL.textContent = 'Auto-refresh paused';
      stopAuto();
    }
  });

  // ── Manual refresh button ─────────────────────────────────────
  REFRESH_BTN.addEventListener('click', () => {
    STATUS_EL.textContent = 'Refreshing…';
    fetchLogs().then(() => {
      // Reset countdown if auto is running
      if (autoEnabled && logsTabActive) {
        stopAuto();
        startAuto();
      }
    });
  });

  // ── Pause when browser tab is hidden, resume on focus ─────────
  document.addEventListener('visibilitychange', () => {
    if (!logsTabActive) return;
    if (document.hidden) {
      stopAuto();
    } else if (autoEnabled) {
      startAuto();
    }
  });

  // ── Activate / deactivate with the Logs nav-tab ───────────────
  document.getElementById('logsTabBtn').addEventListener('click', () => {
    logsTabActive = true;
    if (autoEnabled && !document.hidden) startAuto();
  });

  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
    tab.addEventListener('click', function () {
      if (this.id !== 'logsTabBtn') {
        logsTabActive = false;
        stopAuto();
        STATUS_EL.textContent = '–';
      }
    });
  });
}());

// ── App Logs (PM2 stdout / stderr) ───────────────────────────────────────────
(function () {
  const PROJECT_ID  = '<%= project.id %>';
  const INTERVAL_MS = 3000;
  const container   = document.getElementById('appLogsContainer');
  const statusEl    = document.getElementById('appLogsStatus');
  const linesSelect = document.getElementById('appLogsLines');
  const btnOut      = document.getElementById('btnAppLogsOut');
  const btnErr      = document.getElementById('btnAppLogsErr');
  const btnRefresh  = document.getElementById('btnAppLogsRefresh');
  const btnAuto     = document.getElementById('btnAppLogsAuto');

  let activeStream = 'out';
  let autoEnabled  = true;
  let tabActive    = false;
  let timer        = null;
  let lastData     = { out: '', err: '' };

  function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

  function render() {
    const raw = lastData[activeStream] || '';
    container.innerHTML = raw
      ? escHtml(raw)
      : '<span class="text-muted">No output yet.</span>';
    container.scrollTop = container.scrollHeight;
  }

  async function fetchAppLogs() {
    const lines = linesSelect.value;
    try {
      const res  = await fetch(`/admin/projects/${PROJECT_ID}/runtime-logs?lines=${lines}`);
      const data = await res.json();
      lastData = { out: data.out || '', err: data.err || '' };
      render();
      statusEl.textContent = 'Updated ' + new Date().toLocaleTimeString();
    } catch {
      statusEl.textContent = 'Fetch failed – ' + new Date().toLocaleTimeString();
    }
  }

  function startAuto() {
    if (timer) return;
    fetchAppLogs();
    timer = setInterval(fetchAppLogs, INTERVAL_MS);
  }

  function stopAuto() {
    clearInterval(timer);
    timer = null;
  }

  // Stream toggle
  btnOut.addEventListener('click', () => {
    activeStream = 'out';
    btnOut.classList.replace('btn-outline-secondary', 'btn-primary');
    btnErr.classList.replace('btn-primary', 'btn-outline-secondary');
    render();
  });
  btnErr.addEventListener('click', () => {
    activeStream = 'err';
    btnErr.classList.replace('btn-outline-secondary', 'btn-primary');
    btnOut.classList.replace('btn-primary', 'btn-outline-secondary');
    render();
  });

  // Auto toggle
  btnAuto.addEventListener('click', () => {
    autoEnabled = !autoEnabled;
    if (autoEnabled) {
      btnAuto.className = 'btn btn-sm btn-success py-0 px-2';
      btnAuto.innerHTML = '<i class="bi bi-pause-fill me-1"></i>Auto';
      if (tabActive) startAuto();
    } else {
      btnAuto.className = 'btn btn-sm btn-outline-secondary py-0 px-2';
      btnAuto.innerHTML = '<i class="bi bi-play-fill me-1"></i>Manual';
      stopAuto();
    }
  });

  btnRefresh.addEventListener('click', fetchAppLogs);
  linesSelect.addEventListener('change', fetchAppLogs);

  document.addEventListener('visibilitychange', () => {
    if (!tabActive) return;
    document.hidden ? stopAuto() : (autoEnabled && startAuto());
  });

  document.getElementById('appLogsTabBtn').addEventListener('click', () => {
    tabActive = true;
    if (autoEnabled && !document.hidden) startAuto();
  });

  document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
    tab.addEventListener('click', function () {
      if (this.id !== 'appLogsTabBtn') {
        tabActive = false;
        stopAuto();
      }
    });
  });
}());
</script>

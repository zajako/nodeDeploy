# Application
PORT=8080
NODE_ENV=production
SESSION_SECRET=change-this-to-a-long-random-string
APP_URL=https://npmdeploy.com
# Set to true only after HTTPS/SSL is fully configured — Secure cookies
# will not be sent back by browsers over plain HTTP, breaking sessions.
COOKIE_SECURE=false

# GitHub OAuth App
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://npmdeploy.com/auth/github/callback

# Admin Access (comma-separated GitHub usernames)
ADMIN_GITHUB_USERNAMES=yourgithubusername

# MySQL Database (for the portal itself)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nodedeploy
DB_USER=nodedeploy_user
DB_PASSWORD=secure_password_here

# Deployment Settings
DEPLOY_BASE_PATH=/var/www/nodeapps
STARTING_PORT=4000

# Nginx — path to the auto-generated per-project location blocks include file.
# Must match the `include` directive in npmdeploy.com.conf.
# The portal regenerates this file and reloads nginx automatically on every
# project add/deploy/delete — no manual nginx edits needed per project.
NGINX_PROJECTS_CONF=/home/zajako/nodeDeploy/nginx/projects.conf

# Subdomain routing — projects are served at <name>.<BASE_DOMAIN>
BASE_DOMAIN=npmdeploy.com

# Wildcard TLS cert — use the exact path certbot printed after obtaining the cert.
# Certbot may create npmdeploy.com-0001 instead of npmdeploy.com — check the output.
# Leave empty to serve project subdomains over HTTP only until cert is ready.
#
# IMPORTANT: a wildcard cert obtained with `certbot --manual` CANNOT auto-renew
# (certbot has no way to publish the DNS TXT record on its own) and will expire
# every 90 days. Use a certbot DNS plugin for your DNS provider instead, e.g.:
#   sudo apt install python3-certbot-dns-cloudflare
#   sudo certbot certonly --dns-cloudflare \
#     --dns-cloudflare-credentials /root/.secrets/cloudflare.ini \
#     -d npmdeploy.com -d '*.npmdeploy.com'
# Plugin-issued certs renew automatically via the portal's renewal scheduler.
WILDCARD_CERT_PATH=/etc/letsencrypt/live/npmdeploy.com-0001

# Custom domain auto-SSL — when a custom domain is mapped to a project, the portal
# will automatically run certbot to obtain a cert covering the bare domain and www.
# Leave empty to skip auto-SSL (you can run certbot manually instead).
CERTBOT_EMAIL=you@example.com

# How often (hours) the portal runs `certbot renew` and reloads nginx.
# Certbot only renews certs within 30 days of expiry, so frequent runs are cheap.
CERT_RENEW_INTERVAL_HOURS=12
